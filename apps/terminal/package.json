{
  "name": "terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.tsx",
    "typecheck": "tsc --noEmit",
    "render-smoke": "bun run scripts/render-smoke.tsx",
    "interaction-smoke": "bun run scripts/interaction-smoke.tsx",
    "app-smoke": "bun run scripts/app-smoke.tsx",
    "app-compact-smoke": "AGENTS_TERMINAL_ROWS=18 bun run scripts/app-smoke.tsx",
    "app-short-smoke": "AGENTS_TERMINAL_ROWS=12 bun run scripts/app-smoke.tsx",
    "app-narrow-smoke": "AGENTS_TERMINAL_COLUMNS=64 bun run scripts/app-smoke.tsx",
    "app-tiny-smoke": "AGENTS_TERMINAL_COLUMNS=24 bun run scripts/app-smoke.tsx",
    "app-tiny-fullscreen-smoke": "AGENTS_TERMINAL_FULLSCREEN=1 AGENTS_TERMINAL_COLUMNS=24 bun run scripts/app-smoke.tsx",
    "app-flow-smoke": "bun run scripts/app-flow-smoke.tsx",
    "app-compact-flow-smoke": "AGENTS_TERMINAL_ROWS=18 bun run scripts/app-flow-smoke.tsx",
    "app-short-fullscreen-flow-smoke": "AGENTS_TERMINAL_FULLSCREEN=1 AGENTS_TERMINAL_ROWS=12 bun run scripts/app-flow-smoke.tsx",
    "app-fullscreen-smoke": "AGENTS_TERMINAL_FULLSCREEN=1 bun run scripts/app-flow-smoke.tsx",
    "app-compact-fullscreen-smoke": "AGENTS_TERMINAL_FULLSCREEN=1 AGENTS_TERMINAL_ROWS=18 bun run scripts/app-flow-smoke.tsx",
    "app-inline-smoke": "AGENTS_TERMINAL_FULLSCREEN=0 bun run scripts/app-flow-smoke.tsx",
    "app-pending-resume-smoke": "bun run scripts/app-pending-resume-smoke.tsx",
    "app-real-model-smoke": "bun run scripts/app-real-model-smoke.tsx",
    "tui-audit": "bun run scripts/tui-audit.ts",
    "tui-audit:complete": "bun run scripts/tui-audit.ts --verify-manual",
    "manual-smoke": "bun run scripts/manual-smoke.ts",
    "manual-smoke:check": "bun run scripts/manual-smoke.ts --print-only",
    "manual-smoke:record": "bun run scripts/manual-smoke.ts --record",
    "manual-smoke:verify": "bun run scripts/manual-smoke.ts --verify",
    "fixture": "PYTHONPATH=src:apps/terminal/scripts/fixtures AGENTS_TERMINAL_HISTORY_PATH=/tmp/agents-terminal-fixture-history.json AGENTS_TERMINAL_SESSION_STORE=/tmp/agents-terminal-fixture-sessions bun run src/main.tsx --repo-root ../.. --bridge-module terminal_bridge_fixture"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "figures": "^6.1.0",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
